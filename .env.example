DATABASE_URL=postgres://localhost:5432/cardtracker
JUSTTCG_API_KEY=
# Set true only on a JustTCG plan whose terms permit a public/commercial surface.
JUSTTCG_COMMERCIAL=false

# PSA public API uses a pre-issued bearer token you generate on the PSA site
# (Authentication -> Generate Token), NOT a username/password. The account must
# be approved for API access or calls return 403.
PSA_ACCESS_TOKEN=

PORT=3000
